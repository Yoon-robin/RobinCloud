# RobinCloud: Nextcloud 34.0.5 with the RobinCloud source (github.com/Yoon-robin/RobinCloud) laid over it.
FROM nextcloud:34.0.5-apache
# ffmpeg: thumbnails for videos (the Movie preview provider)
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*
COPY --chown=www-data:www-data src/ /usr/src/nextcloud/
# - no code signature: the source differs from the signed release on purpose
# - new accounts start empty instead of with Nextcloud sample files
# - Nextcloud promo apps (first-run tour, announcements, survey, support) and the
#   Office app are left out: RobinCloud is file storage
# - "Nextcloud" becomes "RobinCloud" in everything users read, plus the Korean
#   overlay (robincloud-rebrand.php, robincloud-l10n/)
RUN rm -f /usr/src/nextcloud/core/signature.json \
 && rm -rf /usr/src/nextcloud/core/skeleton && mkdir /usr/src/nextcloud/core/skeleton \
 && chown www-data:www-data /usr/src/nextcloud/core/skeleton \
 && rm -rf /usr/src/nextcloud/apps/firstrunwizard /usr/src/nextcloud/apps/nextcloud_announcements \
           /usr/src/nextcloud/apps/survey_client /usr/src/nextcloud/apps/support \
           /usr/src/nextcloud/apps/office \
 && php /usr/src/nextcloud/robincloud-rebrand.php /usr/src/nextcloud
# Apache behind the Cloudflare tunnel: HSTS when the visitor came in over HTTPS;
# the SSH-forwarded http://localhost:8080 stays plain
COPY src/robincloud-proxy.conf /etc/apache2/conf-available/robincloud-proxy.conf
RUN a2enconf robincloud-proxy >/dev/null
LABEL org.opencontainers.image.source="https://github.com/Yoon-robin/RobinCloud" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
